# Supabase — Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses row level security, used solely by the Stripe webhook.
# Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic — console.anthropic.com
ANTHROPIC_API_KEY=

# Stripe — use test keys (sk_test_...). STRIPE_PRICE_ID is a recurring price.
# STRIPE_WEBHOOK_SECRET comes from `stripe listen` locally, or the endpoint's
# signing secret in the Stripe dashboard once deployed.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Optional. Set this and Vercel Cron will send it as a bearer token to
# /api/keepalive, so only the cron can run it. Any random string works.
CRON_SECRET=
